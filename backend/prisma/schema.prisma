// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime

  @@map("session")
}

model User {
  id          Int    @id @default(autoincrement())
  username    String @unique
  password    String
  description String @default("")
  pfpPath     String @map("pfp_path")

  reviews  Review[]
  comments Comment[]
  likes    Like[]

  sentConnection     Connection[] @relation("sender")
  receivedConnection Connection[] @relation("receiver")

  watchListMovie  WatchListMovie[]
  watchListSeries WatchListSeries[]

  watchGroupUser WatchGroupUser[]

  @@map("user")
}

model Connection {
  senderId    Int              @map("sender_id")
  receiverId  Int              @map("receiver_id")
  sender      User             @relation(name: "sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User             @relation(name: "receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  dateAdded   DateTime         @default(now()) @map("date_added")
  dateUpdated DateTime         @updatedAt @map("date_updated")
  status      ConnectionStatus @default(pending)

  @@id(name: "connectionId", [senderId, receiverId])
  @@map("connection")
}

model Review {
  id          Int      @id @default(autoincrement())
  authorId    Int      @map("author_id")
  author      User     @relation(fields: [authorId], references: [id])
  content     String
  isPublic    Boolean  @default(true) @map("is_public")
  dateAdded   DateTime @default(now()) @map("date_added")
  dateUpdated DateTime @updatedAt @map("date_updated")
  rating      Int

  /**
   * NOTE:
   * can denormalize title/name of movie/series but
   * there is a chance that tmdb updates posters which
   * results in 404 when client fetches images
   */
  movieId  Int?    @map("movie_id")
  seriesId Int?    @map("series_id")
  movie    Movie?  @relation(fields: [movieId], references: [id])
  series   Series? @relation(fields: [seriesId], references: [id])

  commentCount Int       @default(0) @map("comment_count")
  comments     Comment[]
  likeCount    Int       @default(0) @map("like_count")
  likes        Like[]

  @@unique([authorId, movieId])
  @@unique([authorId, seriesId])
  @@map("review")
}

model Comment {
  id          Int      @id @default(autoincrement())
  authorId    Int      @map("author_id")
  author      User     @relation(fields: [authorId], references: [id])
  reviewId    Int      @map("review_id")
  review      Review   @relation(fields: [reviewId], references: [id])
  content     String
  dateAdded   DateTime @default(now()) @map("date_added")
  dateUpdated DateTime @updatedAt @map("date_updated")

  @@map("comment")
}

model Like {
  userId   Int    @map("user_id")
  user     User   @relation(fields: [userId], references: [id])
  reviewId Int    @map("review_id")
  review   Review @relation(fields: [reviewId], references: [id])

  @@id([userId, reviewId])
  @@map("like")
}

model Movie {
  id            Int     @id
  title         String
  originalTitle String  @map("original_title")
  overview      String
  posterPath    String  @map("poster_path")
  backdropPath  String  @map("backdrop_path")
  releaseDate   String  @map("release_date")
  voteAverage   Decimal @map("vote_average") @db.Decimal(4, 3)
  runtime       Int

  reviews Review[]

  watchList WatchListMovie[]

  watchGroup WatchGroup[]

  @@map("movie")
}

model Series {
  id           Int     @id
  name         String
  originalName String  @map("original_name")
  overview     String
  posterPath   String  @map("poster_path")
  backdropPath String  @map("backdrop_path")
  firstAirDate String  @map("first_air_date")
  voteAverage  Decimal @map("vote_average") @db.Decimal(4, 3)
  status       String
  seasons      Json    @db.JsonB

  reviews Review[]

  watchList WatchListSeries[]

  watchGroup WatchGroup[]

  @@map("series")
}

model WatchListMovie {
  userId     Int     @map("user_id")
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  movieId    Int     @map("movie_id")
  movie      Movie   @relation(fields: [movieId], references: [id])
  hasWatched Boolean @default(false) @map("has_watched")
  rating     Int?

  dateAdded   DateTime @default(now()) @map("date_added")
  dateUpdated DateTime @updatedAt @map("date_updated")

  @@id([userId, movieId])
  @@map("watchlist_movie")
}

model WatchListSeries {
  userId     Int     @map("user_id")
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  seriesId   Int     @map("series_id")
  series     Series  @relation(fields: [seriesId], references: [id])
  hasWatched Boolean @default(false) @map("has_watched")
  rating     Int?

  dateAdded   DateTime @default(now()) @map("date_added")
  dateUpdated DateTime @updatedAt @map("date_updated")

  @@id([userId, seriesId])
  @@map("watchlist_series")
}

model WatchGroup {
  id     Int              @id @default(autoincrement())
  users  WatchGroupUser[]
  series Series[]
  movies Movie[]

  @@map("watch_group")
}

model WatchGroupUser {
  watchGroupId Int        @map("watch_group_id")
  watchGroup   WatchGroup @relation(fields: [watchGroupId], references: [id])
  userId       Int        @map("user_id")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  isAdmin      Boolean    @default(false) @map("is_admin")

  @@id([watchGroupId, userId])
  @@map("watch_group_user")
}

enum ConnectionStatus {
  pending
  accepted

  @@map("connection_status")
}
