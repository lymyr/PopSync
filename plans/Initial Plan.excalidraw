      "seed": 530244285,
      "version": 3042,
      "versionNonce": 20865949,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792736914781,
      "created": 1792735062490,
      "link": null,
      "locked": false,
      "text": "- 4 watch list states: planned,\nwatching, completed, dropped\n- should have 0 - 10 score\n- should have episode tracker\n- add created and updated\ntimestamp\n- should be filterable by name,\nwatch state\n- should be able to order by name,\ncreate/update date, and score\n(default)\n- Should add showId/movieId to\nmy own database for query\nefficiency and avoid rate limits\nwhen showing all movies/shows in\nwatch list\n- can only be viewed by\nconnections\n- should be exportable",
      "fontSize": 19.932356257046223,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- 4 watch list states: planned, watching, completed, dropped\n- should have 0 - 10 score\n- should have episode tracker\n- add created and updated timestamp\n- should be filterable by name, watch state\n- should be able to order by name, create/update date, and score (default)\n- Should add showId/movieId to my own database for query efficiency and avoid rate limits when showing all movies/shows in watch list\n- can only be viewed by connections\n- should be exportable",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
