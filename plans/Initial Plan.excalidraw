      "x": 1116.9632562657916,
      "y": 91.10917619584467,
      "width": 338.81684388652053,
      "height": 473.3934611048478,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "5q-F4rR2q9ksu9GfWDRIu"
      ],
      "frameId": null,
      "index": "aE",
